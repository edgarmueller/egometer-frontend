# Copy to .env.local to override the local defaults from .env.development,
# e.g. to use an API on another host:
# REACT_APP_BASE_URL=http://localhost:3000
# PORT=3001

# Production builds (`npm run build`) need REACT_APP_BASE_URL to be set in the
# environment (or a .env.production.local) to the URL of the deployed API.
